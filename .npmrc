# Render (and other hosts) set NODE_ENV=production for the running app,
# which is required (it gates SSRF protection and secure session cookies —
# see src/server.ts). But npm's default behavior also treats NODE_ENV=production
# as a signal to skip devDependencies during install, which breaks the build
# since TypeScript and all @types/* packages live there. This forces them to
# install regardless, without relying on a platform's dashboard build-command
# setting being configured correctly.
include=dev
